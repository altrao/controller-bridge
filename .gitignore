# ------------------------------------------------------------------ Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
gradle-app.setting
.gradletasknamecache

# Machine-specific SDK path. Never commit -- it hardcodes one developer's machine.
local.properties

# ------------------------------------------------------------------ IDE
.idea/
*.iml
*.iws
*.ipr
out/
captures/

# ------------------------------------------------------------------ Android build output
*.apk
*.aab
*.ap_
*.dex
*.class
.cxx/
release/

# ------------------------------------------------------------------ Signing material
*.jks
*.keystore
*.p12
*.pepk
# Except the fixed debug keystore: a per-CI-run key forces an uninstall on every
# update, which wipes app data (saved server IP). Public android/android creds, not a secret.
!app/debug.keystore

